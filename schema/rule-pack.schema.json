{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psych-rulekit:schema:rule-pack:1.0.0",
  "title": "PsychRuleKit Rule Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "version",
    "description",
    "intendedUse",
    "locale",
    "facts",
    "inclusion",
    "evidence",
    "review",
    "license"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
    "description": { "type": "string", "minLength": 1 },
    "intendedUse": { "enum": ["education", "research", "screening_research"] },
    "locale": { "type": "string", "minLength": 2 },
    "jurisdiction": { "type": "string" },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/factDefinition" }
    },
    "inclusion": { "$ref": "#/$defs/ruleNode" },
    "exclusion": { "$ref": "#/$defs/ruleNode" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidenceReference" }
    },
    "review": { "$ref": "#/$defs/reviewRecord" },
    "license": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "factDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "valueType"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "valueType": { "enum": ["boolean", "number", "string"] },
        "unit": { "enum": ["count", "day", "week", "month", "year", "percent"] },
        "sensitive": { "type": "boolean" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "citation", "permissionStatus"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "citation": { "type": "string", "minLength": 1 },
        "locator": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "license": { "type": "string" },
        "permissionStatus": { "enum": ["open", "permission_granted", "citation_only", "unknown"] }
      }
    },
    "reviewRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["draft", "method_reviewed", "clinically_reviewed", "validated"] },
        "reviewerRole": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date" },
        "notes": { "type": "string" }
      }
    },
    "ruleNode": {
      "oneOf": [
        { "$ref": "#/$defs/factRule" },
        { "$ref": "#/$defs/compareRule" },
        { "$ref": "#/$defs/allRule" },
        { "$ref": "#/$defs/anyRule" },
        { "$ref": "#/$defs/countRule" },
        { "$ref": "#/$defs/notRule" }
      ]
    },
    "baseRuleProperties": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" }
      }
    },
    "factRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "factId"],
      "properties": {
        "kind": { "const": "fact" },
        "id": { "type": "string", "minLength": 1 },
        "factId": { "type": "string", "minLength": 1 },
        "expected": { "type": ["boolean", "string"] },
        "rationale": { "type": "string" }
      }
    },
    "compareRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "factId", "operator", "value"],
      "properties": {
        "kind": { "const": "compare" },
        "id": { "type": "string", "minLength": 1 },
        "factId": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte"] },
        "value": { "type": "number" },
        "rationale": { "type": "string" }
      }
    },
    "allRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "rules"],
      "properties": {
        "kind": { "const": "all" },
        "id": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ruleNode" } },
        "rationale": { "type": "string" }
      }
    },
    "anyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "rules"],
      "properties": {
        "kind": { "const": "any" },
        "id": { "type": "string", "minLength": 1 },
        "rules": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ruleNode" } },
        "atLeast": { "type": "integer", "minimum": 1 },
        "rationale": { "type": "string" }
      }
    },
    "countRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "factIds", "atLeast"],
      "properties": {
        "kind": { "const": "count" },
        "id": { "type": "string", "minLength": 1 },
        "factIds": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
        "atLeast": { "type": "integer", "minimum": 0 },
        "atMost": { "type": "integer", "minimum": 0 },
        "rationale": { "type": "string" }
      }
    },
    "notRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "rule"],
      "properties": {
        "kind": { "const": "not" },
        "id": { "type": "string", "minLength": 1 },
        "rule": { "$ref": "#/$defs/ruleNode" },
        "rationale": { "type": "string" }
      }
    }
  }
}
